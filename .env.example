# Application Settings
APP_NAME="Routica AI Assistant"
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# Security & Authentication
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
JWT_SECRET_KEY=replace-with-a-secure-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-to-your-secure-admin-password

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/routica_chatbot?retryWrites=true&w=majority
MONGODB_DATABASE=routica_chatbot
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# Vector Search Configuration
VECTOR_SEARCH_INDEX_NAME=vector_index
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# AI Providers & LLM Routing (Set at least one provider)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here
CHAT_PRIMARY_PROVIDER=groq
CHAT_PRIMARY_MODEL=groq/llama-3.3-70b-versatile
CHAT_FALLBACK_MODELS=groq/llama-3.1-8b-instant,gemini/gemini-1.5-flash

# CORS & Frontend URL (Leave empty or set to your Render frontend URL)
FRONTEND_URL=https://routica-ai-frontend.onrender.com
ALLOWED_ORIGINS=https://routica-ai-frontend.onrender.com,http://localhost:5173

# File Upload Limits & Storage
MAX_UPLOAD_SIZE_MB=15
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=uploads

# Chat & Retrieval Settings
MAX_CHAT_MESSAGE_LENGTH=5000
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.65
MAX_CONVERSATION_HISTORY=6

# Web Scraping Configuration
SCRAPE_ALLOWED_DOMAINS=routica.com,www.routica.com
SCRAPE_INTERVAL_HOURS=24
SCRAPE_USER_AGENT=RouticaBot/1.0 (+https://routica.com)
SCRAPE_RATE_LIMIT_DELAY_SECONDS=1.0

# Logging
LOG_LEVEL=INFO
